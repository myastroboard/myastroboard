{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MyAstroBoard filter presets",
  "description": "Generated by scripts/build_equipment_presets.py from the rules it checks - do not edit. See docs/EQUIPMENT.md#presets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "presets"
  ],
  "properties": {
    "$schema": {
      "const": "../filters.schema.json"
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/filter"
      }
    }
  },
  "definitions": {
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bandwidth_nm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "built_in": {
          "description": "Part of a smart telescope, not sold on its own: hidden from the preset pickers, weighs 0, reached through the telescope's bundle.",
          "type": "boolean"
        },
        "central_wavelength_nm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 300,
          "maximum": 2000
        },
        "filter_type": {
          "type": "string",
          "enum": [
            "Broadband",
            "H-Alpha",
            "LRGB",
            "Light Pollution Reduction",
            "Luminance",
            "Narrowband",
            "OIII",
            "Other",
            "RGB",
            "SII",
            "Solar",
            "UHC"
          ]
        },
        "id": {
          "description": "Unique snake_case id across every preset file.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "intended_use": {
          "type": "string"
        },
        "label": {
          "description": "Display name; becomes the item name.",
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "description": "Brand, exactly as the file is named after it.",
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "description": "The maker's official spec page every value comes from.",
          "type": "string"
        },
        "suggests_experience": {
          "description": "Sorts the presets matching the user experience level first.",
          "type": "string",
          "enum": [
            "advanced",
            "beginner",
            "intermediate"
          ]
        },
        "weight_kg": {
          "description": "For a smart telescope: the whole unit. A built-in item weighs 0.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "filter_type",
        "id",
        "label",
        "manufacturer"
      ],
      "if": {
        "properties": {
          "built_in": {
            "const": true
          }
        },
        "required": [
          "built_in"
        ]
      },
      "then": {
        "properties": {
          "weight_kg": {
            "const": 0
          }
        },
        "required": [
          "weight_kg"
        ]
      },
      "else": {
        "required": [
          "source_url",
          "suggests_experience"
        ]
      }
    }
  }
}
