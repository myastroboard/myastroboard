{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MyAstroBoard telescope presets",
  "description": "Generated by scripts/build_equipment_presets.py from the rules it checks - do not edit. See docs/EQUIPMENT.md#presets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "presets"
  ],
  "properties": {
    "$schema": {
      "const": "../telescopes.schema.json"
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/telescope"
      }
    }
  },
  "definitions": {
    "telescope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aperture_mm": {
          "type": "number",
          "minimum": 10,
          "maximum": 5000
        },
        "auto_combination": {
          "description": "Create the bundle items and a combination when this preset is picked.",
          "type": "boolean"
        },
        "bundle": {
          "description": "Ids of the camera, mount, filters and accessories that come with this telescope: one camera, at most one mount.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        },
        "focal_length_mm": {
          "type": "number",
          "minimum": 100,
          "maximum": 50000
        },
        "focal_ratio": {
          "description": "Informational; the app recalculates it from focal length / aperture.",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "description": "Unique snake_case id across every preset file.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "label": {
          "description": "Display name; becomes the item name.",
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "description": "Brand, exactly as the file is named after it.",
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "description": "The maker's official spec page every value comes from.",
          "type": "string"
        },
        "suggests_experience": {
          "description": "Sorts the presets matching the user experience level first.",
          "type": "string",
          "enum": [
            "advanced",
            "beginner",
            "intermediate"
          ]
        },
        "type": {
          "description": "A preset code, not the form label.",
          "type": "string",
          "enum": [
            "apo",
            "cassegrain",
            "dobsonian",
            "edgehd",
            "maksutov",
            "newtonian",
            "rasa",
            "rc",
            "reflector",
            "refractor",
            "sct"
          ]
        },
        "weight_kg": {
          "description": "For a smart telescope: the whole unit. A built-in item weighs 0.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "aperture_mm",
        "focal_length_mm",
        "id",
        "label",
        "manufacturer",
        "source_url",
        "suggests_experience",
        "type",
        "weight_kg"
      ]
    }
  }
}
